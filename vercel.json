{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/user/(.*)",
      "dest": "/api/user/$1"
    },
    {
      "src": "/user",
      "dest": "/api/user"
    },
    {
      "src": "/product/(.*)",
      "dest": "/api/product/$1"
    },
    {
      "src": "/product",
      "dest": "/api/product"
    },
    {
      "src": "/buy/(.*)",
      "dest": "/api/buy/$1"
    },
    {
      "src": "/buy",
      "dest": "/api/buy"
    },
    {
      "src": "/order/(.*)",
      "dest": "/api/order/$1"
    },
    {
      "src": "/order",
      "dest": "/api/order"
    },
    {
      "src": "/webhook",
      "dest": "/api/webhook"
    },
    {
      "src": "/health",
      "dest": "/api/health"
    },
    {
      "src": "/api-docs/(.*)",
      "dest": "/api/api-docs/$1"
    },
    {
      "src": "/api-docs",
      "dest": "/api/api-docs"
    },
    {
      "src": "/api-docs.json",
      "dest": "/api/api-docs.json"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
